<%
  const meta = Object.assign({
    title: 'Kaamelott API – Citations et répliques cultes à la volette',
    description: 'API gratuite et sonothèque Kaamelott : des centaines de citations cultes et de répliques audio d\'Arthur, Perceval, Karadoc et toute la Table ronde. Aléatoire, par id ou par mot-clé.',
    canonical: null,
    noindex: false,
  }, typeof page !== 'undefined' ? page : {});
  const ogImage = siteUrl + '/images/og-image.jpg';
%>
<!DOCTYPE html>
<html lang="fr">

<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title><%= meta.title %></title>
  <meta name="description" content="<%= meta.description %>">
  <meta name="author" content="Kenny Caldieraro">
  <meta name="theme-color" content="#0e0d0b">
  <meta name="color-scheme" content="dark">
  <% if (meta.noindex) { %>
  <meta name="robots" content="noindex, follow">
  <% } else { %>
  <meta name="robots" content="index, follow, max-image-preview:large">
  <% } %>
  <% if (meta.canonical) { %>
  <link rel="canonical" href="<%= meta.canonical %>">
  <% } %>

  <!-- Open Graph / réseaux sociaux -->
  <meta property="og:type" content="website">
  <meta property="og:locale" content="fr_FR">
  <meta property="og:site_name" content="Kaamelott API">
  <meta property="og:title" content="<%= meta.title %>">
  <meta property="og:description" content="<%= meta.description %>">
  <meta property="og:url" content="<%= meta.canonical || siteUrl + '/' %>">
  <meta property="og:image" content="<%= ogImage %>">
  <meta property="og:image:width" content="1200">
  <meta property="og:image:height" content="630">
  <meta property="og:image:alt" content="Le roi Arthur de Kaamelott et le logo de la série">
  <meta name="twitter:card" content="summary_large_image">
  <meta name="twitter:title" content="<%= meta.title %>">
  <meta name="twitter:description" content="<%= meta.description %>">
  <meta name="twitter:image" content="<%= ogImage %>">

  <link rel="icon" href="/favicon.ico" sizes="any">
  <link rel="icon" href="/images/icon-192.png" type="image/png">
  <link rel="apple-touch-icon" href="/images/apple-touch-icon.png">
  <link rel="manifest" href="/site.webmanifest">

  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Cinzel:wght@600;800&family=Inter:wght@400;500;600&display=swap">
  <link rel="preload" as="image" href="/images/bg.webp" type="image/webp" media="(min-width: 1025px)">
  <link rel="preload" as="image" href="/images/bg-1024.webp" type="image/webp" media="(max-width: 1024px)">
  <link rel="stylesheet" href="/css/style.css?v=<%= assetVersion %>">
  <%- typeof head !== 'undefined' ? head : '' %>
</head>

